# .env.example
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/healthcare_db
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecretkey
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Internal Service URLs (local dev)
AUTH_SERVICE_URL=http://localhost:8001
USER_SERVICE_URL=http://localhost:8002
FACILITY_SERVICE_URL=http://localhost:8003
REQUEST_SERVICE_URL=http://localhost:8004
ROUTING_SERVICE_URL=http://localhost:8006
AUDIT_SERVICE_URL=http://localhost:8008

# Cluster Service URLs (K8s)
# AUTH_SERVICE_URL=http://auth-svc.backend.svc.cluster.local
# ...
